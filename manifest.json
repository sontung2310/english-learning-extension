{
  "manifest_version": 3,
  "name": "English Learner",
  "version": "1.0.0",
  "description": "Right click any English word or sentence to save it. Track what you learn every day.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "English Learner"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
